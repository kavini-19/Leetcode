class Solution {
    public int longestPalindrome(String s) {
        HashSet<Character> set = new HashSet<>();
        int length = 0;
            for(int i = 0;i<s.length();i++){
                char c = s.charAt(i);
                if(set.contains(c)){
                    length += 2;
                    set.remove(c);
                }
                else{
                    set.add(c);
                }
            }
            if(!set.isEmpty()){
                length++;
            }
        
        return length;
    }
}
